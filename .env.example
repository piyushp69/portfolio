# Copy to .env (or set these in your host's dashboard). Both are optional.

# Public URL of the deployed site, without a trailing slash. Enables the
# canonical link and social-preview (og:image) tags. Vercel and Netlify
# builds detect it automatically, so you only need it elsewhere.
SITE_URL=

# Form endpoint that accepts a JSON POST, e.g. https://formspree.io/f/abcdwxyz
# When set, the contact form delivers messages here. When empty, it opens the
# visitor's mail app with the message pre-filled instead.
VITE_CONTACT_ENDPOINT=
